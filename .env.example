# Copie para .env e preencha. O .env NUNCA vai para o git.
#
# Groq — usado por reclassify_subtemas.py e generate_explanations.py
# Gere em: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini — pool com uma ou mais chaves para explicações/validação
# Gere em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: várias chaves separadas por vírgula (tem precedência sobre GEMINI_API_KEY).
GEMINI_API_KEYS=
# Opcional: ordem de fallback de modelos separada por vírgula.
# Ex.: gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS=
# Opcional: espera mínima, em segundos, após uma quota diária/financeira por chave.
# Chaves de contas distintas continuam sendo usadas normalmente.
GEMINI_ACCOUNT_QUOTA_COOLDOWN=300

# Flask
FLASK_ENV=development
FLASK_PORT=5050
# Lista de origens CORS explícitas, separadas por vírgula. "*" é rejeitado.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Clerk/JWT. O issuer e o JWKS são derivados da publishable key por padrão.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Opcionais para instalações com issuer/JWKS customizados.
CLERK_ISSUER=
CLERK_JWKS_URL=
# Configure somente se os tokens Clerk da instalação contiverem aud.
CLERK_JWT_AUDIENCE=

# Banco remoto Turso. Transações stateful exigem libsql:// ou wss://.
# URLs http:// e https:// são rejeitadas no startup para evitar falsa atomicidade.
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Segredo compartilhado entre o proxy Next.js e o backend Flask.
FLASK_API_PROXY_SECRET=

# Token separado para o endpoint operacional /api/metrics/performance.
# Se ausente, o endpoint fica desabilitado fora de testes.
METRICS_API_TOKEN=
